# Factory Platform — All Environment Variables

# Required — Supabase (free at supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required — Twilio (free trial at twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWIL...n
# Optional — Resend (free: 100 emails/day)
RESEND_API_KEY=*** Optional — Stripe (for payments + subscriptions)
STRIPE_SECRET_KEY=
NEXT...n
# Optional — OpenAI (for AI photo estimates + translations)
OPENAI_API_KEY=*** Optional — Cal.com (for booking)
CALCOM_API_KEY=
CALC...n
# Optional — PostHog (for analytics)
POSTHOG_API_KEY=
NEXT...n
# Cron security
CRON_SECRET=

# Site URL (set to your Vercel URL after deploy)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
