# Factory Platform — Environment Variables

# Supabase (free at supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio (free trial at twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Resend (free at resend.com — 100 emails/day)
RESEND_API_KEY=

# Stripe (test mode at stripe.com)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Cal.com (from cal.com/settings/developer/api-keys)
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=5925689

# Site URL (set to your Vercel URL after deploy)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Your email (receives notifications until per-business routing is active)
ADMIN_EMAIL=rece.grisham@gmail.com
